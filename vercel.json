{
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/index" },
    { "source": "/blog", "destination": "/api/index" },
    { "source": "/blog/", "destination": "/api/index" },
    { "source": "/blog/:slug", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/admin", "destination": "/recruitment/web/admin.html" },
    { "source": "/admin/(.*)", "destination": "/recruitment/web/admin.html" },
    { "source": "/recruitment-assets/(.*)", "destination": "/recruitment/web/$1" }
  ],
  "redirects": [
    { "source": "/careers", "destination": "/careers.html", "permanent": false },
    { "source": "/recruitment/web/careers.html", "destination": "/careers.html", "permanent": false },
    { "source": "/apply", "destination": "/apply.html", "permanent": false }
  ]
}
