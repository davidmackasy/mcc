{
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/index" },
    { "source": "/blog", "destination": "/api/index" },
    { "source": "/blog/", "destination": "/api/index" },
    { "source": "/blog/:slug", "destination": "/api/index" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/industries", "destination": "/industries.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/apply", "destination": "/apply.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/janitorial-cleaning", "destination": "/janitorial-cleaning.html" },
    { "source": "/carpet-upholstery-cleaning", "destination": "/carpet-upholstery-cleaning.html" },
    { "source": "/floor-care", "destination": "/floor-care.html" },
    { "source": "/window-cleaning", "destination": "/window-cleaning.html" },
    { "source": "/post-construction-cleaning", "destination": "/post-construction-cleaning.html" },
    { "source": "/pressure-washing", "destination": "/pressure-washing.html" },
    { "source": "/medical-dental-cleaning", "destination": "/medical-dental-cleaning.html" },
    { "source": "/drive-thru-exterior-detailing", "destination": "/drive-thru-exterior-detailing.html" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/admin", "destination": "/recruitment/web/admin.html" },
    { "source": "/admin/(.*)", "destination": "/recruitment/web/admin.html" },
    { "source": "/recruitment-assets/(.*)", "destination": "/recruitment/web/$1" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/industries.html", "destination": "/industries", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/careers.html", "destination": "/careers", "permanent": true },
    { "source": "/apply.html", "destination": "/apply", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/janitorial-cleaning.html", "destination": "/janitorial-cleaning", "permanent": true },
    { "source": "/carpet-upholstery-cleaning.html", "destination": "/carpet-upholstery-cleaning", "permanent": true },
    { "source": "/floor-care.html", "destination": "/floor-care", "permanent": true },
    { "source": "/window-cleaning.html", "destination": "/window-cleaning", "permanent": true },
    { "source": "/post-construction-cleaning.html", "destination": "/post-construction-cleaning", "permanent": true },
    { "source": "/pressure-washing.html", "destination": "/pressure-washing", "permanent": true },
    { "source": "/medical-dental-cleaning.html", "destination": "/medical-dental-cleaning", "permanent": true },
    { "source": "/drive-thru-exterior-detailing.html", "destination": "/drive-thru-exterior-detailing", "permanent": true },
    { "source": "/recruitment/web/careers.html", "destination": "/careers", "permanent": false }
  ]
}
